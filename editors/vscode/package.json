{
  "name": "acl2-session",
  "displayName": "ACL2",
  "description": "Live form-by-form checking of ACL2 books, driven by the acl2-session-editor daemon",
  "version": "0.0.1",
  "publisher": "gjurgensen",
  "private": true,
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.77.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjurgensen/acl2-session-server"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "acl2",
        "aliases": [
          "ACL2",
          "acl2"
        ],
        "extensions": [
          ".lisp",
          ".acl2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "acl2",
        "scopeName": "source.acl2",
        "path": "./syntaxes/acl2.tmLanguage.json"
      }
    ],
    "colors": [
      {
        "id": "acl2Session.token.name",
        "description": "Panel terms: defined names. Used only when the active theme's token colors could not be read; otherwise the panel takes its colors from the theme itself.",
        "defaults": { "light": "terminal.ansiYellow", "dark": "terminal.ansiBrightYellow", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.keyword",
        "description": "Panel terms: :keywords and rune classes, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiMagenta", "dark": "terminal.ansiBrightMagenta", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.constant",
        "description": "Panel terms: t, nil and *constants*, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiBlue", "dark": "terminal.ansiBrightBlue", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.number",
        "description": "Panel terms: numbers, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiMagenta", "dark": "terminal.ansiBrightMagenta", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.string",
        "description": "Panel terms: strings and character literals, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiGreen", "dark": "terminal.ansiBrightGreen", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.comment",
        "description": "Panel terms: comments, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiBrightBlack", "dark": "terminal.ansiBrightBlack", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.storage",
        "description": "Panel terms: definer heads such as defthm, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiYellow", "dark": "terminal.ansiYellow", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.control",
        "description": "Panel terms: binding and event forms, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiRed", "dark": "terminal.ansiBrightRed", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "acl2Session.token.punctuation",
        "description": "Panel terms: parentheses, when the theme's token colors could not be read.",
        "defaults": { "light": "terminal.ansiWhite", "dark": "terminal.ansiWhite", "highContrast": "foreground", "highContrastLight": "foreground" }
      }
    ],
    "commands": [
      {
        "command": "acl2-session.start",
        "title": "ACL2: Start Live Checking"
      },
      {
        "command": "acl2-session.stop",
        "title": "ACL2: Stop Live Checking"
      },
      {
        "command": "acl2-session.interrupt",
        "title": "ACL2: Interrupt"
      },
      {
        "command": "acl2-session.evalSelection",
        "title": "ACL2: Evaluate Selection"
      },
      {
        "command": "acl2-session.showConsole",
        "title": "ACL2: Show Console"
      },
      {
        "command": "acl2-session.retractToCursor",
        "title": "ACL2: Retract to Cursor"
      },
      {
        "command": "acl2-session.targetAtCursor",
        "title": "ACL2: Target at Cursor"
      },
      {
        "command": "acl2-session.clearTarget",
        "title": "ACL2: Clear Target"
      },
      {
        "command": "acl2-session.showOutput",
        "title": "ACL2: Show Output for Form at Cursor"
      },
      {
        "command": "acl2-session.showPanel",
        "title": "ACL2: Show Panel"
      },
      {
        "command": "acl2-session.gotoFrontier",
        "title": "ACL2: Go to Frontier"
      }
    ],
    "configuration": {
      "title": "ACL2",
      "properties": {
        "acl2-session.daemonPath": {
          "type": "string",
          "default": "acl2-session-editor",
          "description": "Path to the acl2-session-editor binary."
        },
        "acl2-session.defaultImage": {
          "type": "string",
          "default": "",
          "description": "ACL2 image for books outside any trusted checkout (--default). ACL2_DEFAULT in the environment works too."
        },
        "acl2-session.trusted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories whose ACL2 checkouts are trusted (--trusted, repeatable). ACL2_TRUSTED in the environment works too."
        },
        "acl2-session.decorations": {
          "type": "string",
          "enum": [
            "minimal",
            "wash"
          ],
          "default": "minimal",
          "enumDescriptions": [
            "Gutter status column: bars over unprocessed lines, a checkmark per admitted form, reds as diagnostics, and only the conditional wash.",
            "Whole-form background washes, reds included, and no diagnostics."
          ],
          "description": "How unit statuses are rendered."
        },
        "acl2-session.gutterAdmitted": {
          "type": "boolean",
          "default": true,
          "description": "In minimal mode, mark admitted forms with a green gutter bar (olive for conditional). Off, absence means admitted."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.77.0",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
