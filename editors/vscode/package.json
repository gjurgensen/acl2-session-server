{
  "name": "acl2-session",
  "displayName": "ACL2",
  "icon": "media/icon.png",
  "description": "Live form-by-form checking of ACL2 books, driven by the acl2-session-editor daemon",
  "version": "0.0.1",
  "publisher": "gjurgensen",
  "private": true,
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.77.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjurgensen/acl2-session-server"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:acl2"
  ],
  "contributes": {
    "languages": [
      {
        "id": "acl2",
        "aliases": [
          "ACL2",
          "acl2"
        ],
        "extensions": [
          ".lisp",
          ".acl2"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "acl2-output",
        "aliases": [
          "ACL2 Output"
        ]
      }
    ],
    "grammars": [
      {
        "language": "acl2",
        "scopeName": "source.acl2",
        "path": "./syntaxes/acl2.tmLanguage.json"
      },
      {
        "language": "acl2-output",
        "scopeName": "source.acl2-output",
        "path": "./syntaxes/acl2-output.tmLanguage.json"
      }
    ],
    "colors": [
      {
        "id": "acl2Session.token.name",
        "description": "Panel terms: defined names. Used only when the active theme's token colors could not be read; otherwise the panel takes its colors from the theme itself.",
        "defaults": {
          "light": "terminal.ansiYellow",
          "dark": "terminal.ansiBrightYellow",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.keyword",
        "description": "Panel terms: :keywords and rune classes, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiMagenta",
          "dark": "terminal.ansiBrightMagenta",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.constant",
        "description": "Panel terms: t, nil and *constants*, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiBlue",
          "dark": "terminal.ansiBrightBlue",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.number",
        "description": "Panel terms: numbers, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiMagenta",
          "dark": "terminal.ansiBrightMagenta",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.string",
        "description": "Panel terms: strings and character literals, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiGreen",
          "dark": "terminal.ansiBrightGreen",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.comment",
        "description": "Panel terms: comments, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiBrightBlack",
          "dark": "terminal.ansiBrightBlack",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.storage",
        "description": "Panel terms: definer heads such as defthm, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiYellow",
          "dark": "terminal.ansiYellow",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.control",
        "description": "Panel terms: binding and event forms, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiRed",
          "dark": "terminal.ansiBrightRed",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.punctuation",
        "description": "Panel terms: parentheses, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiWhite",
          "dark": "terminal.ansiWhite",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      }
    ],
    "commands": [
      {
        "command": "acl2-session.start",
        "title": "ACL2: Start Live Checking",
        "icon": "$(play)"
      },
      {
        "command": "acl2-session.stop",
        "title": "ACL2: Stop Live Checking",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acl2-session.interrupt",
        "title": "ACL2: Interrupt"
      },
      {
        "command": "acl2-session.evalSelection",
        "title": "ACL2: Evaluate Selection"
      },
      {
        "command": "acl2-session.showConsole",
        "title": "ACL2: Show Console"
      },
      {
        "command": "acl2-session.retractToCursor",
        "title": "ACL2: Retract to Cursor"
      },
      {
        "command": "acl2-session.targetAtCursor",
        "title": "ACL2: Target at Cursor"
      },
      {
        "command": "acl2-session.clearTarget",
        "title": "ACL2: Clear Target"
      },
      {
        "command": "acl2-session.showOutput",
        "title": "ACL2: Show Output for Form at Cursor"
      },
      {
        "command": "acl2-session.certify",
        "title": "ACL2: Certify Book",
        "icon": "$(verified)"
      },
      {
        "command": "acl2-session.showDocs",
        "title": "ACL2: Show Documentation for Name at Cursor"
      },
      {
        "command": "acl2-session.lockPanel",
        "title": "ACL2: Hold Panel on This Form",
        "icon": "$(unlock)"
      },
      {
        "command": "acl2-session.unlockPanel",
        "title": "ACL2: Release Panel",
        "icon": "$(lock)"
      },
      {
        "command": "acl2-session.togglePanelLock",
        "title": "ACL2: Toggle Panel Hold"
      },
      {
        "command": "acl2-session.showPanel",
        "title": "ACL2: Show Panel"
      },
      {
        "command": "acl2-session.gotoFrontier",
        "title": "ACL2: Go to Frontier"
      },
      {
        "command": "acl2-session.gotoAttention",
        "title": "ACL2: Go to Next Attention Point"
      }
    ],
    "configuration": {
      "title": "ACL2",
      "properties": {
        "acl2-session.daemonPath": {
          "type": "string",
          "default": "acl2-session-editor",
          "description": "Path to the acl2-session-editor binary."
        },
        "acl2-session.warnOnProveOutputOverride": {
          "type": "boolean",
          "default": true,
          "description": "Warn once when the server re-enables PROVE output because your ACL2 environment (e.g. acl2-customization.lsp) inhibits it. The override is needed to capture proofs and does not change what your file admits; turn this off to stop the notice. The output channel logs it regardless."
        },
        "acl2-session.defaultImage": {
          "type": "string",
          "default": "",
          "description": "ACL2 image for books outside any trusted checkout (--default). ACL2_DEFAULT in the environment works too."
        },
        "acl2-session.trusted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories whose ACL2 checkouts are trusted (--trusted, repeatable). ACL2_TRUSTED in the environment works too."
        },
        "acl2-session.decorations": {
          "type": "string",
          "enum": [
            "minimal",
            "wash"
          ],
          "default": "minimal",
          "enumDescriptions": [
            "Gutter status column: bars over unprocessed lines, a checkmark per admitted form, reds as diagnostics, and only the conditional wash.",
            "Whole-form background washes, reds included, and no diagnostics."
          ],
          "description": "How unit statuses are rendered."
        },
        "acl2-session.gutterAdmitted": {
          "type": "boolean",
          "default": true,
          "description": "In minimal mode, mark admitted forms with a green gutter bar (olive for conditional). Off, absence means admitted."
        },
        "acl2-session.highlightOutput": {
          "type": "boolean",
          "default": true,
          "description": "Highlight ACL2's output log: goal headers, errors and Q.E.D. as markers, and the terms inside goals, rune lists and `pe` forms as Lisp. Best effort -- the log is prose with Lisp embedded in it, so a misread is possible; off, the log is plain text."
        },
        "acl2-session.termWidth": {
          "type": "number",
          "default": 60,
          "minimum": 20,
          "description": "Maximum width, in characters, that terms in the panel are laid out to. The pane's own width is used when it is narrower; this is a ceiling, not a target. ACL2 prints for a 77-column terminal, so a wide pane would otherwise leave every term on one long line."
        },
        "acl2-session.hoverWidth": {
          "type": "number",
          "default": 60,
          "minimum": 20,
          "description": "Width, in characters, that terms in a hover are laid out to. A fixed number rather than a measurement: VSCode tells an extension nothing about the size of a hover, and a tooltip is not a webview, so nothing can measure it. Matches the panel's default so a term reads the same in both."
        },
        "acl2-session.certifyJobs": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "description": "Parallel jobs for cert.pl (-j) when certifying."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "acl2-session.start",
          "when": "editorLangId == acl2 && !acl2Session.active",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.stop",
          "when": "editorLangId == acl2 && acl2Session.active",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.certify",
          "when": "editorLangId == acl2 && acl2Session.active",
          "group": "navigation@2"
        },
        {
          "command": "acl2-session.lockPanel",
          "when": "activeWebviewPanelId == 'acl2SessionPanel' && !acl2Session.panelLocked",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.unlockPanel",
          "when": "activeWebviewPanelId == 'acl2SessionPanel' && acl2Session.panelLocked",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "acl2-session.lockPanel",
          "when": "!acl2Session.panelLocked"
        },
        {
          "command": "acl2-session.unlockPanel",
          "when": "acl2Session.panelLocked"
        }
      ]
    },
    "keybindings": [
      {
        "command": "acl2-session.start",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.interrupt",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.targetAtCursor",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.retractToCursor",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.clearTarget",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.showPanel",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.showConsole",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.evalSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.showOutput",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.gotoFrontier",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.gotoAttention",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorLangId == acl2"
      }
    ],
    "taskDefinitions": [
      {
        "type": "acl2",
        "required": [],
        "properties": {}
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.77.0",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
