{
  "name": "acl2-session",
  "displayName": "ACL2",
  "icon": "media/icon.png",
  "description": "Live form-by-form checking of ACL2 books, driven by the acl2-session-editor daemon",
  "version": "0.0.1",
  "publisher": "gjurgensen",
  "private": true,
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.77.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjurgensen/acl2-session-server"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:acl2"
  ],
  "contributes": {
    "languages": [
      {
        "id": "acl2",
        "aliases": [
          "ACL2",
          "acl2"
        ],
        "extensions": [
          ".lisp",
          ".acl2"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "acl2-output",
        "aliases": [
          "ACL2 Output"
        ]
      }
    ],
    "configurationDefaults": {
      "[acl2]": {
        "editor.colorDecorators": false,
        "editor.wordSeparators": "()[]{}'\"`,;|",
        "editor.autoIndent": "keep",
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnType": true,
        "editor.formatOnPaste": true
      },
      "[acl2-output]": {
        "editor.colorDecorators": false
      }
    },
    "grammars": [
      {
        "language": "acl2",
        "scopeName": "source.acl2",
        "path": "./syntaxes/acl2.tmLanguage.json"
      },
      {
        "language": "acl2-output",
        "scopeName": "source.acl2-output",
        "path": "./syntaxes/acl2-output.tmLanguage.json"
      }
    ],
    "colors": [
      {
        "id": "acl2Session.token.name",
        "description": "Form view terms: defined names. Used only when the active theme's token colors could not be read; otherwise the form view takes its colors from the theme itself.",
        "defaults": {
          "light": "terminal.ansiYellow",
          "dark": "terminal.ansiBrightYellow",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.keyword",
        "description": "Form view terms: :keywords and rune classes, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiMagenta",
          "dark": "terminal.ansiBrightMagenta",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.constant",
        "description": "Form view terms: t, nil and *constants*, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiBlue",
          "dark": "terminal.ansiBrightBlue",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.number",
        "description": "Form view terms: numbers, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiMagenta",
          "dark": "terminal.ansiBrightMagenta",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.string",
        "description": "Form view terms: strings and character literals, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiGreen",
          "dark": "terminal.ansiBrightGreen",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.comment",
        "description": "Form view terms: comments, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiBrightBlack",
          "dark": "terminal.ansiBrightBlack",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.storage",
        "description": "Form view terms: definer heads such as defthm, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiYellow",
          "dark": "terminal.ansiYellow",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.control",
        "description": "Form view terms: binding and event forms, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiRed",
          "dark": "terminal.ansiBrightRed",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.token.punctuation",
        "description": "Form view terms: parentheses, when the theme's token colors could not be read.",
        "defaults": {
          "light": "terminal.ansiWhite",
          "dark": "terminal.ansiWhite",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "acl2Session.bar.pending",
        "description": "The status column's bar for a pending form, and the same bar drawn inline where two forms share a line. Also its mark in the overview ruler.",
        "defaults": {
          "light": "#61616166",
          "dark": "#cccccc59",
          "highContrast": "#cccccc59",
          "highContrastLight": "#61616166"
        }
      },
      {
        "id": "acl2Session.bar.running",
        "description": "The status column's bar for a running form, and the same bar drawn inline where two forms share a line. Also its mark in the overview ruler.",
        "defaults": {
          "light": "#6161618c",
          "dark": "#cccccc80",
          "highContrast": "#cccccc80",
          "highContrastLight": "#6161618c"
        }
      },
      {
        "id": "acl2Session.bar.admitted",
        "description": "The status column's bar for a admitted form, and the same bar drawn inline where two forms share a line. Also its mark in the overview ruler.",
        "defaults": {
          "light": "#388a348c",
          "dark": "#89d18580",
          "highContrast": "#89d18580",
          "highContrastLight": "#388a348c"
        }
      },
      {
        "id": "acl2Session.bar.conditional",
        "description": "The status column's bar for a conditional form, and the same bar drawn inline where two forms share a line. Also its mark in the overview ruler.",
        "defaults": {
          "light": "#bf8803bf",
          "dark": "#cca700b3",
          "highContrast": "#cca700b3",
          "highContrastLight": "#bf8803bf"
        }
      },
      {
        "id": "acl2Session.bar.skipped",
        "description": "The status column's bar for a skipped form, and the same bar drawn inline where two forms share a line. Also its mark in the overview ruler.",
        "defaults": {
          "light": "#e51400b3",
          "dark": "#f14c4ca6",
          "highContrast": "#f14c4ca6",
          "highContrastLight": "#e51400b3"
        }
      },
      {
        "id": "acl2Session.bar.failed",
        "description": "The status column's bar for a failed form, and the same bar drawn inline where two forms share a line. Also its mark in the overview ruler.",
        "defaults": {
          "light": "#e51400b3",
          "dark": "#f14c4ca6",
          "highContrast": "#f14c4ca6",
          "highContrastLight": "#e51400b3"
        }
      },
      {
        "id": "acl2Session.bar.target",
        "description": "The held target: the mark after the last form that will be checked.",
        "defaults": {
          "light": "#1a85ffe6",
          "dark": "#3794ffd9",
          "highContrast": "#3794ffd9",
          "highContrastLight": "#1a85ffe6"
        }
      },
      {
        "id": "acl2Session.wash.admitted",
        "description": "The background wash over a admitted form, in the 'wash' decoration mode.",
        "defaults": {
          "light": "#388a3426",
          "dark": "#89d1851a",
          "highContrast": "#89d1851a",
          "highContrastLight": "#388a3426"
        }
      },
      {
        "id": "acl2Session.wash.conditional",
        "description": "The background wash over a conditional form, in the 'wash' decoration mode.",
        "defaults": {
          "light": "#bf880326",
          "dark": "#cca7001a",
          "highContrast": "#cca7001a",
          "highContrastLight": "#bf880326"
        }
      },
      {
        "id": "acl2Session.wash.skipped",
        "description": "The background wash over a skipped form, in the 'wash' decoration mode.",
        "defaults": {
          "light": "#e5140026",
          "dark": "#f14c4c1a",
          "highContrast": "#f14c4c1a",
          "highContrastLight": "#e5140026"
        }
      },
      {
        "id": "acl2Session.wash.failed",
        "description": "The background wash over a failed form, in the 'wash' decoration mode.",
        "defaults": {
          "light": "#e5140026",
          "dark": "#f14c4c1a",
          "highContrast": "#f14c4c1a",
          "highContrastLight": "#e5140026"
        }
      },
      {
        "id": "acl2Session.wash.running",
        "description": "The background wash over a running form, in the 'wash' decoration mode.",
        "defaults": {
          "light": "#1a85ff26",
          "dark": "#3794ff1a",
          "highContrast": "#3794ff1a",
          "highContrastLight": "#1a85ff26"
        }
      }
    ],
    "commands": [
      {
        "command": "acl2-session.start",
        "category": "ACL2",
        "title": "Start Live Checking",
        "icon": "$(debug-start)"
      },
      {
        "command": "acl2-session.stop",
        "category": "ACL2",
        "title": "Stop Live Checking",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acl2-session.pause",
        "category": "ACL2",
        "title": "Pause",
        "icon": "$(debug-pause)"
      },
      {
        "command": "acl2-session.resume",
        "category": "ACL2",
        "title": "Resume",
        "icon": "$(debug-continue)"
      },
      {
        "command": "acl2-session.interrupt",
        "category": "ACL2",
        "title": "Interrupt"
      },
      {
        "command": "acl2-session.evalSelection",
        "category": "ACL2",
        "title": "Evaluate Selection"
      },
      {
        "command": "acl2-session.showConsole",
        "category": "ACL2",
        "title": "Show Console"
      },
      {
        "command": "acl2-session.retractToCursor",
        "category": "ACL2",
        "title": "Retract to Cursor"
      },
      {
        "command": "acl2-session.targetAtCursor",
        "category": "ACL2",
        "title": "Target at Cursor"
      },
      {
        "command": "acl2-session.targetForward",
        "category": "ACL2",
        "title": "Target Forward One Form"
      },
      {
        "command": "acl2-session.targetBackward",
        "category": "ACL2",
        "title": "Target Back One Form"
      },
      {
        "command": "acl2-session.targetTop",
        "category": "ACL2",
        "title": "Target Before First Form"
      },
      {
        "command": "acl2-session.clearTarget",
        "category": "ACL2",
        "title": "Clear Target"
      },
      {
        "command": "acl2-session.showOutput",
        "category": "ACL2",
        "title": "Show Output"
      },
      {
        "command": "acl2-session.certify",
        "category": "ACL2",
        "title": "Certify Book",
        "icon": "$(verified)"
      },
      {
        "command": "acl2-session.showDocs",
        "category": "ACL2",
        "title": "Show Documentation for Name at Cursor"
      },
      {
        "command": "acl2-session.pinFormView",
        "category": "ACL2",
        "title": "Pin to This Form",
        "icon": "$(pinned)"
      },
      {
        "command": "acl2-session.unpinFormView",
        "category": "ACL2",
        "title": "Unpin",
        "icon": "$(pin)"
      },
      {
        "command": "acl2-session.toggleFormViewPin",
        "category": "ACL2",
        "title": "Toggle Pin"
      },
      {
        "command": "acl2-session.showFormView",
        "category": "ACL2",
        "title": "Show Form View"
      },
      {
        "command": "acl2-session.gotoFrontier",
        "category": "ACL2",
        "title": "Go to Frontier"
      },
      {
        "command": "acl2-session.gotoAttention",
        "category": "ACL2",
        "title": "Go to Next Attention Point"
      },
      {
        "command": "acl2-session.indent",
        "category": "ACL2",
        "title": "Indent Line or Selection"
      }
    ],
    "configuration": {
      "title": "ACL2",
      "properties": {
        "acl2-session.daemonPath": {
          "type": "string",
          "default": "acl2-session-editor",
          "description": "Path to the acl2-session-editor binary."
        },
        "acl2-session.warnOnProveOutputOverride": {
          "type": "boolean",
          "default": true,
          "description": "Warn once when the server re-enables PROVE output because your ACL2 environment (e.g. acl2-customization.lsp) inhibits it. The override is needed to capture proofs and does not change what your file admits; turn this off to stop the notice. The output channel logs it regardless."
        },
        "acl2-session.defaultImage": {
          "type": "string",
          "default": "",
          "description": "ACL2 image for books outside any trusted checkout (--default). ACL2_DEFAULT in the environment works too."
        },
        "acl2-session.trusted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories whose ACL2 checkouts are trusted (--trusted, repeatable). ACL2_TRUSTED in the environment works too."
        },
        "acl2-session.decorations": {
          "type": "string",
          "enum": [
            "gutter",
            "wash",
            "minimal"
          ],
          "default": "gutter",
          "enumDescriptions": [
            "A status column of bars beside every form -- grey queued, blue proving, green admitted, yellow conditional, red failed -- and nothing on the text itself.",
            "A background wash over the whole of every form, reds included.",
            "Only what is happening or wrong: a bar beside the form being proved, and failures as problems. An admitted form is unremarkable, a conditional one follows from the failure above it, and one not reached yet follows from sitting below the running one."
          ],
          "description": "How unit statuses are rendered."
        },
        "acl2-session.problems": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report failed and skipped forms in the Problems view.\n\nVSCode draws a squiggle along with each entry and offers no way to have one without the other, so this is both. In the `minimal` decoration mode it is a failure's only mark, scrollbar included."
        },
        "acl2-session.conditionalWarnings": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Report **conditional** forms as warnings in the Problems view.\n\nA conditional form was proved correctly, but on top of a claim that was not \u2014 a form above it went in with its proofs skipped. Off by default because everything below a skipped form is conditional, so this can be a great many rows."
        },
        "acl2-session.formWarnings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report ACL2's own warnings \u2014 `Double-rewrite`, `Use`, `Subsume` \u2014 in the Problems view.\n\nThe kind is all there is: ACL2 records the *set* a form emitted, so five double-rewrite warnings look like one, and what any of them says is in that form's output. How many forms carry one varies from 1% to 40% by book; turn this off if yours is at the high end."
        },
        "acl2-session.highlightOutput": {
          "type": "boolean",
          "default": true,
          "description": "Highlight ACL2's output log: goal headers, errors and Q.E.D. as markers, and the terms inside goals, rune lists and `pe` forms as Lisp. Best effort -- the log is prose with Lisp embedded in it, so a misread is possible; off, the log is plain text."
        },
        "acl2-session.eventsOpenLimit": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "description": "How many events a form may record before the form view stops opening them by default. At or below this, every event's block starts expanded; above it, all of them start collapsed. A macro like defines can record hundreds, and a page of hundreds of open blocks cannot be scrolled past."
        },
        "acl2-session.termWidth": {
          "type": "number",
          "default": 60,
          "minimum": 20,
          "description": "Maximum width, in characters, that terms in the form view are laid out to. The pane's own width is used when it is narrower; this is a ceiling, not a target. ACL2 prints for a 77-column terminal, so a wide pane would otherwise leave every term on one long line."
        },
        "acl2-session.hoverWidth": {
          "type": "number",
          "default": 60,
          "minimum": 20,
          "markdownDescription": "Width, in characters, that terms in a hover are laid out to. A fixed number because VSCode tells an extension nothing about a hover's size and a tooltip cannot measure itself. Matches the form view's default, so a term reads the same in both."
        },
        "acl2-session.certifyJobs": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "description": "Parallel jobs for cert.pl (-j) when certifying."
        },
        "acl2-session.colors": {
          "type": "object",
          "default": {},
          "markdownDescription": "Override a status colour. Each status takes `bar` and `wash`, and each of those a string or `{ light, dark }` \u2014 any CSS colour, including `color-mix` over a theme variable. The gutter bar is the exception: it is an image, so only a literal reaches it.\n\nSee the extension README for the four sources and their precedence.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "bar": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "One colour for both light and dark themes."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "light": {
                        "type": "string"
                      },
                      "dark": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "description": "A colour per theme kind."
                  }
                ],
                "description": "The status column bar, the inline bar, and the ruler mark."
              },
              "wash": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "One colour for both light and dark themes."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "light": {
                        "type": "string"
                      },
                      "dark": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "description": "A colour per theme kind."
                  }
                ],
                "description": "The background wash, in the 'wash' decoration mode."
              }
            },
            "additionalProperties": false
          },
          "examples": [
            {
              "failed": {
                "bar": "#ff5555"
              },
              "running": {
                "bar": {
                  "light": "#0057b7",
                  "dark": "#7fb8ff"
                }
              }
            }
          ]
        },
        "acl2-session.washOpacity": {
          "default": null,
          "markdownDescription": "How strong the background washes are: a number, or `{ light, dark }`. Worth touching because how far a tint reads depends on the background under it. Adjusts whichever colour won, except one written out in full under `acl2-session.colors`.",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "One opacity for both light and dark themes."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "An opacity per theme kind.",
              "properties": {
                "light": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "dark": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null",
              "description": "The shipped defaults."
            }
          ],
          "examples": [
            0.22,
            {
              "light": 0.2,
              "dark": 0.16
            }
          ]
        },
        "acl2-session.tabIndents": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Make Tab re-indent the current line, the way it does in Emacs, when the cursor is in an ACL2 file with nothing selected. On by default; it is also the repair for a line no formatter is asked about, such as one opened by Vim's `o`.\n\nWhat it costs is a literal tab at the cursor. Turn it off to get VSCode's Tab back \u2014 indenting stays available as **ACL2: Indent Line or Selection**."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "acl2-session.start",
          "when": "editorLangId == acl2 && !acl2Session.active",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.pause",
          "when": "editorLangId == acl2 && acl2Session.active && !acl2Session.paused",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.resume",
          "when": "editorLangId == acl2 && acl2Session.active && acl2Session.paused",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.stop",
          "when": "editorLangId == acl2 && acl2Session.active",
          "group": "1_acl2@1"
        },
        {
          "command": "acl2-session.certify",
          "when": "editorLangId == acl2 && acl2Session.active",
          "group": "1_acl2@2"
        },
        {
          "command": "acl2-session.pinFormView",
          "when": "activeWebviewPanelId == 'acl2SessionFormView' && !acl2Session.formViewPinned",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.unpinFormView",
          "when": "activeWebviewPanelId == 'acl2SessionFormView' && acl2Session.formViewPinned",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.pinFormView",
          "when": "resourceScheme == acl2-session-output && !acl2Session.formViewPinned",
          "group": "navigation@1"
        },
        {
          "command": "acl2-session.unpinFormView",
          "when": "resourceScheme == acl2-session-output && acl2Session.formViewPinned",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "acl2-session.pinFormView",
          "when": "!acl2Session.formViewPinned"
        },
        {
          "command": "acl2-session.unpinFormView",
          "when": "acl2Session.formViewPinned"
        },
        {
          "command": "acl2-session.pause",
          "when": "!acl2Session.paused"
        },
        {
          "command": "acl2-session.resume",
          "when": "acl2Session.paused"
        }
      ]
    },
    "keybindings": [
      {
        "command": "acl2-session.start",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.interrupt",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.targetAtCursor",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.targetForward",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.targetBackward",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.retractToCursor",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.clearTarget",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.showFormView",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.showConsole",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.evalSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.showOutput",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.gotoFrontier",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.gotoAttention",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorLangId == acl2"
      },
      {
        "command": "acl2-session.indent",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == acl2 && config.acl2-session.tabIndents && !editorHasSelection && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorReadonly && (!vim.active || vim.mode == 'Insert')"
      }
    ],
    "taskDefinitions": [
      {
        "type": "acl2",
        "required": [],
        "properties": {}
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.77.0",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
