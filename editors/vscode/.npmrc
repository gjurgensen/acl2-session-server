# `engines` is advisory to npm by default: a dependency this Node cannot run
# installs anyway, with a WARN that scrolls past inside the deprecation notices,
# and the failure resurfaces later as a stack trace from somewhere else. The
# one that prompted this was `@vscode/vsce`, which needs Node 20 and dies on 16
# with "ReferenceError: ReadableStream is not defined" -- naming neither Node
# nor itself.
#
# Strict makes npm refuse at install time and say which package, what it
# requires, and what you have. That is the whole reason the packaging tool is a
# dependency here rather than an `npx` download: so the version floor is
# checked by the tooling, and no README has to carry it.
engine-strict=true
